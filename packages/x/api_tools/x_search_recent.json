{
  "name": "x_search_recent",
  "description": "Search posts from the last 7 days. Returns { data: [...], meta }. Query syntax: words are ANDed, \"quoted phrases\" match exactly, `from:handle`, `-is:retweet`, `has:links`. Reads are billed too.",
  "method": "GET",
  "url": "https://api.x.com/2/tweets/search/recent?query={query}&max_results={max_results}&tweet.fields=created_at,public_metrics&expansions=author_id&user.fields=username",
  "headers": {
    "Authorization": "Bearer $X_ACCESS_TOKEN",
    "Accept": "application/json",
    "Content-Type": "application/json"
  },
  "parameters": {
    "type": "object",
    "properties": {
      "query": {
        "type": "string",
        "description": "Search query, e.g. 'from:degenspartan -is:retweet'."
      },
      "max_results": {
        "type": "integer",
        "description": "How many posts, 10-100. Default 10."
      }
    },
    "required": [
      "query"
    ]
  },
  "body_mapping": "none"
}
